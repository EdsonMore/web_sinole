---
import '../styles/global.css';
import Icono from '../components/Icono.astro';
import { SITE, SOCIAL } from '../site';

interface Props { titulo?: string; descripcion?: string }
const { titulo, descripcion = `${SITE.nombreLargo}. ${SITE.lema}.` } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${SITE.nombre}` : `${SITE.nombre} – ${SITE.nombreLargo}`;
const ruta = Astro.url.pathname;
const menu = [
  { href: '/', texto: 'Inicio' },
  { href: '/noticias', texto: 'Noticias' },
  { href: '/quienes-somos', texto: 'Quiénes Somos' },
  { href: '/contacto', texto: 'Contacto' },
];
const activo = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={new URL('/logos/sinole.jpg', Astro.site)} />
    <meta name="theme-color" content="#0b4523" />
    <link rel="icon" href="/logos/sinole.jpg" />
  </head>
  <body class="flex min-h-screen flex-col bg-papel font-sans text-stone-800 antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-3">Saltar al contenido</a>

    <!-- Franja institucional -->
    <div class="bg-verde-900 text-xs text-verde-100">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-1.5">
        <span class="truncate">RUC {SITE.ruc} · {SITE.direccion}</span>
        <span class="hidden italic sm:inline">“{SITE.lema}”</span>
      </div>
    </div>

    <header class="sticky top-0 z-40 border-b border-stone-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="flex items-center gap-3">
          <img src="/logos/sinole.jpg" alt="Logo SINOLE" width="48" height="48" class="h-12 w-12 rounded-full" />
          <span class="leading-tight">
            <span class="block font-serif text-xl font-bold text-verde-800">SINOLE</span>
            <span class="block text-xs text-stone-500">Afiliado a FEDUNPE</span>
          </span>
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
          {menu.map((m) => (
            <a href={m.href} aria-current={activo(m.href) ? 'page' : undefined}
              class:list={['rounded-md px-3 py-2 font-medium transition-colors hover:bg-verde-50 hover:text-verde-800', activo(m.href) ? 'text-verde-800 underline decoration-rojo-600 decoration-2 underline-offset-8' : 'text-stone-700']}>
              {m.texto}
            </a>
          ))}
          <span class="mx-2 h-6 w-px bg-stone-200"></span>
          {SOCIAL.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={`${s.nombre} de SINOLE`} class="rounded-full p-2 text-stone-600 transition-colors hover:bg-verde-50 hover:text-verde-800">
              <Icono nombre={s.nombre} />
            </a>
          ))}
        </nav>

        <!-- Menú móvil sin JavaScript -->
        <details class="group relative md:hidden">
          <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-stone-300 px-3 py-2 font-medium text-verde-800 [&::-webkit-details-marker]:hidden">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            Menú
          </summary>
          <nav class="absolute right-0 mt-2 w-60 rounded-lg border border-stone-200 bg-white p-2 shadow-xl" aria-label="Móvil">
            {menu.map((m) => (
              <a href={m.href} class:list={['block rounded-md px-4 py-3 text-lg', activo(m.href) ? 'bg-verde-50 font-semibold text-verde-800' : 'text-stone-700']}>{m.texto}</a>
            ))}
          </nav>
        </details>
      </div>
    </header>

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <!-- Botones flotantes de redes -->
    <div class="fixed bottom-4 right-4 z-40 flex flex-col gap-2">
      {SOCIAL.map((s) => (
        <a href={s.url} target="_blank" rel="noopener" aria-label={`Síguenos en ${s.nombre}`} title={`Síguenos en ${s.nombre}`}
          class:list={['grid h-12 w-12 place-items-center rounded-full text-white shadow-lg ring-2 ring-white transition-transform hover:scale-110',
            { 'bg-[#1877f2]': s.nombre === 'Facebook', 'bg-black': s.nombre === 'TikTok', 'bg-gradient-to-tr from-[#f58529] via-[#dd2a7b] to-[#8134af]': s.nombre === 'Instagram' }]}>
          <Icono nombre={s.nombre} class="h-6 w-6" />
        </a>
      ))}
    </div>

    <footer class="bg-verde-900 text-verde-100">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
        <div>
          <div class="flex items-center gap-3">
            <img src="/logos/sinole.jpg" alt="" width="56" height="56" class="h-14 w-14 rounded-full" />
            <img src="/logos/fedunpe.jpg" alt="Logo FEDUNPE" width="84" height="56" class="h-14 w-auto rounded bg-white p-1" />
          </div>
          <p class="mt-4 text-sm">{SITE.nombreLargo}</p>
          <p class="mt-1 text-sm italic text-verde-100/80">“{SITE.lema}”</p>
        </div>
        <div>
          <h2 class="font-serif text-lg font-semibold text-white">Enlaces</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {menu.map((m) => <li><a href={m.href} class="hover:text-white hover:underline">{m.texto}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="font-serif text-lg font-semibold text-white">Síguenos</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {SOCIAL.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-white hover:underline"><Icono nombre={s.nombre} class="h-4 w-4" /> {s.nombre} · {s.usuario}</a></li>
            ))}
          </ul>
          <p class="mt-4 text-sm">{SITE.direccion}</p>
        </div>
      </div>
      <div class="border-t border-white/10 py-4 text-center text-xs text-verde-100/70">
        © {new Date().getFullYear()} SINOLE · RUC {SITE.ruc} · Fundado el {SITE.fundacion}
      </div>
    </footer>
  </body>
</html>
