---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((noticia) => ({ params: { id: noticia.id }, props: { noticia } }));
}

const { noticia } = Astro.props;
const { Content } = await render(noticia);
const { titulo, fecha, imagenes, resumen, categoria, enlaces_redes } = noticia.data;
const [portada, ...resto] = imagenes;

const redDe = (url: string) => {
  const host = new URL(url).hostname;
  if (/facebook\.com|fb\.watch|fb\.com/.test(host)) return { nombre: 'Facebook', clase: 'bg-[#1877f2]' } as const;
  if (/tiktok\.com/.test(host)) return { nombre: 'TikTok', clase: 'bg-black' } as const;
  if (/instagram\.com/.test(host)) return { nombre: 'Instagram', clase: 'bg-gradient-to-tr from-[#f58529] via-[#dd2a7b] to-[#8134af]' } as const;
  return { nombre: null, clase: 'bg-verde-700' } as const;
};
const fechaTxt = fecha.toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const url = encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href);
const texto = encodeURIComponent(titulo);
---
<Base titulo={titulo} descripcion={resumen}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <a href="/noticias" class="text-verde-700 hover:underline">← Todas las noticias</a>
    <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-rojo-700">{categoria} · <time datetime={fecha.toISOString()}>{fechaTxt}</time></p>
    <h1 class="aparecer mt-2 font-serif text-3xl font-bold leading-tight text-stone-900 md:text-5xl">{titulo}</h1>
    <p class="mt-4 text-xl text-stone-600">{resumen}</p>
    {portada && (
      <a href={portada} target="_blank" rel="noopener" class="mt-8 block" title="Ver imagen completa">
        <img src={portada} alt={`Imagen principal: ${titulo}`} class="aspect-[16/9] w-full rounded-xl object-cover shadow" />
      </a>
    )}
    <div class="prose prose-lg prose-stone mt-8 max-w-none prose-headings:font-serif prose-headings:text-verde-900 prose-a:text-verde-700">
      <Content />
    </div>

    {resto.length > 0 && (
      <section class="mt-12">
        <h2 class="font-serif text-2xl font-bold text-verde-900">Galería</h2>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {resto.map((src, i) => (
            <a href={src} target="_blank" rel="noopener" class="group block overflow-hidden rounded-lg bg-verde-50 shadow-sm" title="Ver imagen completa">
              <img src={src} alt={`Foto ${i + 2} de ${imagenes.length}: ${titulo}`} loading="lazy" class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-105" />
            </a>
          ))}
        </div>
      </section>
    )}

    {enlaces_redes.length > 0 && (
      <section class="mt-10">
        <h2 class="font-serif text-2xl font-bold text-verde-900">Mira esta noticia en nuestras redes</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          {enlaces_redes.map((url) => {
            const red = redDe(url);
            return (
              <a href={url} target="_blank" rel="noopener" class:list={['inline-flex items-center gap-2 rounded-lg px-5 py-3 text-lg font-semibold text-white shadow transition-opacity hover:opacity-90', red.clase]}>
                {red.nombre && <Icono nombre={red.nombre} />}
                {red.nombre ? `Ver en ${red.nombre}` : 'Ver publicación'}
              </a>
            );
          })}
        </div>
      </section>
    )}

    <div class="mt-12 rounded-xl border border-stone-200 bg-white p-6">
      <p class="font-semibold text-stone-900">Comparte esta noticia</p>
      <div class="mt-3 flex flex-wrap gap-3">
        <a href={`https://wa.me/?text=${texto}%20${url}`} target="_blank" rel="noopener" class="rounded-lg bg-[#25d366] px-4 py-2 font-semibold text-white hover:opacity-90">WhatsApp</a>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${url}`} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-[#1877f2] px-4 py-2 font-semibold text-white hover:opacity-90"><Icono nombre="Facebook" class="h-4 w-4" /> Facebook</a>
      </div>
    </div>
  </article>
</Base>
