---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TarjetaNoticia from '../components/TarjetaNoticia.astro';
import Icono from '../components/Icono.astro';
import { SITE, SOCIAL } from '../site';

const ultimas = (await getCollection('noticias'))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 3);

const pilares = [
  { titulo: 'Defensa laboral', texto: 'Velamos por los derechos, la estabilidad y la seguridad de cada trabajador del Oleoducto Norperuano.', icono: 'M12 3l8 4v5c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V7l8-4z' },
  { titulo: 'Petroperú para el Perú', texto: 'Defendemos una empresa estatal fuerte, al servicio del país y de su seguridad energética.', icono: 'M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6' },
  { titulo: 'Unidad sindical', texto: 'Junto a FEDUNPE articulamos la voz de los trabajadores petroleros a nivel nacional.', icono: 'M17 20v-2a4 4 0 00-3-3.9M7 20v-2a4 4 0 013-3.9M12 11a4 4 0 100-8 4 4 0 000 8z' },
  { titulo: 'Información veraz', texto: 'Explicamos con datos y en lenguaje claro lo que está en juego para los trabajadores y la región.', icono: 'M4 5h16v12H8l-4 4V5z' },
];

const preguntas = [
  { p: '¿Qué es SINOLE?', r: `Es el ${SITE.nombreLargo}, fundado el ${SITE.fundacion}. Representa a los trabajadores de las operaciones del Oleoducto Norperuano.` },
  { p: '¿Qué es FEDUNPE?', r: 'La Federación de Unidad Nacional del Petróleo y Energía, que agrupa a sindicatos del sector para defender en conjunto los derechos de los trabajadores y la industria energética nacional.' },
  { p: '¿Cómo puedo afiliarme o hacer una consulta?', r: `Acércate a nuestro local en ${SITE.direccion}, escríbenos desde la página de Contacto o envíanos un mensaje por nuestras redes sociales.` },
  { p: '¿Dónde me entero de los comunicados oficiales?', r: 'En la sección Noticias de esta web y en nuestras cuentas oficiales de Facebook, TikTok e Instagram.' },
];
---
<Base>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-verde-900 text-white">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 22px 22px;"></div>
    <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-verde-600/30 blur-3xl"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:grid-cols-[1.3fr_1fr] md:py-24">
      <div class="aparecer">
        <p class="inline-block rounded-full border border-white/20 bg-white/5 px-4 py-1 text-sm text-verde-100">Desde 1976 · Piura, Perú</p>
        <h1 class="mt-5 font-serif text-4xl font-bold leading-tight md:text-6xl">
          Trabajadores del Oleoducto,<br /><span class="text-verde-100">unidos por el Perú.</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg text-verde-100/90">{SITE.nombreLargo}. Defendemos los derechos laborales y una Petroperú fuerte al servicio de todos los peruanos.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/contacto" class="rounded-lg bg-rojo-600 px-6 py-3.5 text-center text-lg font-semibold shadow-lg transition-colors hover:bg-rojo-700">Contáctanos</a>
          <a href="/noticias" class="rounded-lg border-2 border-white/70 px-6 py-3.5 text-center text-lg font-semibold transition-colors hover:bg-white hover:text-verde-900">Ver comunicados</a>
        </div>
        <p class="mt-8 font-serif text-xl italic text-verde-100">“{SITE.lema}”</p>
      </div>
      <div class="aparecer mx-auto [animation-delay:150ms]">
        <img src="/logos/sinole.jpg" alt="Escudo de SINOLE" width="380" height="380" class="w-64 rounded-full bg-white p-2 shadow-2xl ring-8 ring-white/10 md:w-[360px]" />
      </div>
    </div>
  </section>

  <!-- PILARES -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center font-serif text-3xl font-bold text-verde-900 md:text-4xl">¿Qué hacemos?</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-stone-600">Nuestro trabajo diario por los afiliados y por el país.</p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {pilares.map((p) => (
        <div class="revelar rounded-xl border border-stone-200 bg-white p-6 shadow-sm transition-transform hover:-translate-y-1">
          <span class="grid h-12 w-12 place-items-center rounded-lg bg-verde-50 text-verde-700">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={p.icono} /></svg>
          </span>
          <h3 class="mt-4 font-serif text-xl font-bold text-stone-900">{p.titulo}</h3>
          <p class="mt-2 text-stone-600">{p.texto}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- NOTICIAS -->
  <section class="border-y border-stone-200 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-rojo-700">Actualidad</p>
          <h2 class="font-serif text-3xl font-bold text-verde-900 md:text-4xl">Últimas noticias</h2>
        </div>
        <a href="/noticias" class="font-semibold text-verde-700 hover:underline">Ver todas →</a>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {ultimas.map((n) => <TarjetaNoticia noticia={n} />)}
      </div>
    </div>
  </section>

  <!-- PREGUNTAS FRECUENTES -->
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="text-center font-serif text-3xl font-bold text-verde-900 md:text-4xl">Preguntas frecuentes</h2>
    <div class="mt-8 space-y-3">
      {preguntas.map((q) => (
        <details class="group rounded-xl border border-stone-200 bg-white p-5 shadow-sm open:border-verde-600">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold text-stone-900 [&::-webkit-details-marker]:hidden">
            {q.p}
            <span class="text-2xl text-verde-700 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-stone-600">{q.r}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- REDES -->
  <section class="bg-verde-800 py-14 text-white">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <h2 class="font-serif text-3xl font-bold">Infórmate al instante</h2>
      <p class="mx-auto mt-2 max-w-xl text-verde-100">Videos, comunicados y convocatorias en nuestras redes oficiales.</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {SOCIAL.map((s) => (
          <a href={s.url} target="_blank" rel="noopener" class="flex items-center justify-center gap-3 rounded-xl bg-white/10 px-6 py-5 text-lg font-semibold ring-1 ring-white/20 transition-colors hover:bg-white hover:text-verde-900">
            <Icono nombre={s.nombre} class="h-7 w-7" />
            <span class="text-left leading-tight">{s.nombre}<span class="block text-sm font-normal opacity-80">{s.usuario}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FEDUNPE -->
  <section class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-14 text-center md:flex-row md:text-left">
    <img src="/logos/fedunpe.jpg" alt="Logo FEDUNPE" width="200" height="133" class="w-48 rounded-lg bg-white p-2 shadow" />
    <div>
      <h2 class="font-serif text-2xl font-bold text-verde-900">Miembros de FEDUNPE</h2>
      <p class="mt-2 max-w-2xl text-stone-600">Federación de Unidad Nacional del Petróleo y Energía: la unión de los trabajadores petroleros del Perú.</p>
    </div>
  </section>
</Base>
