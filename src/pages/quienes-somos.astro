---
import Base from '../layouts/Base.astro';
import { existsSync, readdirSync } from 'node:fs';
import { SITE, FEDUNPE } from '../site';

// Se leen al compilar: basta subir archivos a public/ y volver a desplegar.
const logoPetroperu = ['svg', 'png', 'jpg', 'webp'].map((e) => `/logos/petroperu.${e}`).find((f) => existsSync(`public${f}`));
const galeria = existsSync('public/galeria')
  ? readdirSync('public/galeria').filter((f) => /\.(jpe?g|png|webp|mp4|webm)$/i.test(f)).sort()
  : [];

const hitos = [
  { anio: '1976', texto: `Se funda el sindicato el ${SITE.fundacion} (R.D. 005-ORNT).` },
  { anio: 'Hoy', texto: 'Representamos a los trabajadores de Petroperú – Operaciones Oleoducto desde Piura.' },
  { anio: FEDUNPE.sigla, texto: `Integramos la ${FEDUNPE.nombre} junto a ${FEDUNPE.sindicatos.filter((s) => s.sigla !== SITE.nombre).map((s) => `${s.sigla} (${s.ciudad})`).join(', ')}.` },
];
const valores = ['Unidad', 'Transparencia', 'Solidaridad', 'Defensa del patrimonio nacional', 'Seguridad en el trabajo', 'Respeto'];
---
<Base titulo="Quiénes Somos" descripcion={`Conoce a SINOLE: ${SITE.nombreLargo}.`}>
  <section class="bg-verde-900 py-14 text-white">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="aparecer font-serif text-4xl font-bold md:text-5xl">Quiénes somos</h1>
      <p class="mt-3 max-w-2xl text-lg text-verde-100">{SITE.nombreLargo}.</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:grid-cols-[1fr_1.4fr]">
    <img src="/logos/sinole.jpg" alt="Escudo de SINOLE" width="360" height="360" class="revelar mx-auto w-64 md:w-80" />
    <div class="revelar">
      <h2 class="font-serif text-3xl font-bold text-verde-900">Nuestra historia</h2>
      <p class="mt-4 text-lg text-stone-700">
        Desde 1976, SINOLE agrupa a los trabajadores que operan y mantienen el Oleoducto Norperuano, columna vertebral
        del transporte de crudo desde la Amazonía hasta la costa. Nacimos para defender condiciones de trabajo dignas y seguras,
        y para proteger a Petroperú como patrimonio de todos los peruanos.
      </p>
      <p class="mt-4 text-lg text-stone-700">
        Nuestro lema, <strong class="text-verde-800">“{SITE.lema}”</strong>, resume la forma en que trabajamos:
        con unidad, diálogo y firmeza.
      </p>
      <p class="mt-4 text-sm text-stone-500">RUC {SITE.ruc} · {SITE.direccion}</p>
    </div>
  </section>

  <section class="bg-verde-800 py-14 text-white">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 md:grid-cols-[1fr_1.6fr]">
      {logoPetroperu
        ? <img src={logoPetroperu} alt="Logo de Petroperú" class="revelar mx-auto w-56 rounded-lg bg-white p-4" />
        : <p class="revelar text-center font-serif text-5xl font-black tracking-tight md:text-6xl">PETRO<span class="text-rojo-600">PERÚ</span></p>}
      <div class="revelar">
        <h2 class="font-serif text-3xl font-bold">Sindicato de Trabajadores de Petroperú</h2>
        <p class="mt-3 text-lg text-verde-100">
          Somos trabajadores de Petróleos del Perú – Operaciones Oleoducto. Junto a {FEDUNPE.sigla} defendemos a la empresa
          estatal y a quienes la hacen funcionar cada día.
        </p>
        <a href={SITE.petroperu} target="_blank" rel="noopener" class="mt-5 inline-block rounded-lg bg-white px-5 py-2.5 font-semibold text-verde-900 hover:bg-verde-50">Visitar petroperu.com.pe ↗</a>
      </div>
    </div>
  </section>

  {galeria.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-center font-serif text-3xl font-bold text-verde-900">Galería institucional</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {galeria.map((f) => /\.(mp4|webm)$/i.test(f)
          ? <video src={`/galeria/${f}`} controls muted playsinline preload="metadata" class="aspect-video w-full rounded-xl bg-black shadow-sm"></video>
          : <img src={`/galeria/${f}`} alt="Foto institucional de SINOLE" loading="lazy" class="aspect-video w-full rounded-xl object-cover shadow-sm" />)}
      </div>
    </section>
  )}

  <section class="border-y border-stone-200 bg-white py-16">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 md:grid-cols-2">
      <div class="revelar rounded-xl border-l-4 border-verde-700 bg-verde-50 p-8">
        <h2 class="font-serif text-2xl font-bold text-verde-900">Misión</h2>
        <p class="mt-3 text-lg text-stone-700">Representar y defender los derechos e intereses de los trabajadores del Oleoducto, promoviendo su bienestar, su seguridad y su desarrollo profesional.</p>
      </div>
      <div class="revelar rounded-xl border-l-4 border-rojo-600 bg-red-50 p-8">
        <h2 class="font-serif text-2xl font-bold text-verde-900">Visión</h2>
        <p class="mt-3 text-lg text-stone-700">Ser un sindicato referente en el sector energético nacional por su unidad, transparencia y compromiso con una Petroperú fuerte y al servicio del país.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center font-serif text-3xl font-bold text-verde-900">Nuestra trayectoria</h2>
    <ol class="mx-auto mt-10 max-w-2xl border-l-2 border-verde-600">
      {hitos.map((h) => (
        <li class="revelar relative mb-8 pl-8">
          <span class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full border-2 border-white bg-verde-700"></span>
          <p class="font-serif text-xl font-bold text-rojo-700">{h.anio}</p>
          <p class="mt-1 text-lg text-stone-700">{h.texto}</p>
        </li>
      ))}
    </ol>

    <h2 class="mt-12 text-center font-serif text-3xl font-bold text-verde-900">Nuestros valores</h2>
    <ul class="mt-8 flex flex-wrap justify-center gap-3">
      {valores.map((v) => <li class="rounded-full border border-verde-600 bg-white px-5 py-2 font-medium text-verde-800">{v}</li>)}
    </ul>
  </section>
</Base>
