---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { SITE, SOCIAL } from '../site';

const tel = SITE.telefono.replace(/\D/g, '');
const mapa = `https://maps.google.com/maps?q=${encodeURIComponent('Jr. Junín 1130, Piura, Perú')}&z=16&output=embed`;
---
<Base titulo="Contacto" descripcion={`Contacta a SINOLE en ${SITE.direccion}.`}>
  <section class="bg-verde-900 py-14 text-white">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="aparecer font-serif text-4xl font-bold md:text-5xl">Contacto</h1>
      <p class="mt-3 text-lg text-verde-100">Estamos para atenderte. Elige el medio que prefieras.</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-4 py-14 lg:grid-cols-2">
    <div class="space-y-4">
      <a href={`https://wa.me/${tel}`} target="_blank" rel="noopener" class="flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-[#25d366] text-xl text-white" aria-hidden="true">✆</span>
        <span><span class="block text-sm text-stone-500">WhatsApp / Teléfono</span><span class="text-lg font-semibold text-stone-900">{SITE.telefono}</span></span>
      </a>
      <a href={`mailto:${SITE.email}`} class="flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-verde-700 text-xl text-white" aria-hidden="true">✉</span>
        <span><span class="block text-sm text-stone-500">Correo electrónico</span><span class="text-lg font-semibold text-stone-900">{SITE.email}</span></span>
      </a>
      <div class="flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
        <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-rojo-600 text-xl text-white" aria-hidden="true">⌂</span>
        <span><span class="block text-sm text-stone-500">Local sindical</span><span class="text-lg font-semibold text-stone-900">{SITE.direccion}</span></span>
      </div>

      <div class="rounded-xl bg-verde-800 p-6 text-white">
        <p class="font-serif text-xl font-bold">Escríbenos por redes</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-3">
          {SOCIAL.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" class="flex items-center justify-center gap-2 rounded-lg bg-white/10 px-4 py-3 font-semibold ring-1 ring-white/20 hover:bg-white hover:text-verde-900">
              <Icono nombre={s.nombre} /> {s.nombre}
            </a>
          ))}
        </div>
      </div>
    </div>

    <iframe title="Ubicación del local de SINOLE" src={mapa} loading="lazy" referrerpolicy="no-referrer-when-downgrade"
      class="h-[420px] w-full rounded-xl border border-stone-200 shadow-sm lg:h-full"></iframe>
  </section>
</Base>
